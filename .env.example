# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง (ห้ามใส่ค่าเซ็นซิทีฟในไฟล์นี้/อัปโหลดขึ้น git)

# Flask secret — สร้าง random ex.:
#   PowerShell: [System.Security.Cryptography.RNGCryptoServiceProvider]::new().GetBytes((New-Object byte[] 32)) ...
SECRET_KEY=please-change-me

# classid สำหรับส่งคะแนน getscore1
CLASS_ID=

# course_id (คั่นด้วย comma) ที่ "ให้คะแนนเว็บ" ใช้ได้ — วิชาอื่นดูได้แค่งาน
WEB_GRADE_COURSES=